/// Real {{name}} domain backed by the native bridge.
class {{Pascal}}DomainImpl implements {{Pascal}}Domain {
  /// Creates a {{name}} domain with optional test doubles for cache/registry.
  {{Pascal}}DomainImpl({
    TtlCache<{{Pascal}}Info>? snapshotCache,
    SharedStreamRegistry? streamRegistry,
  })  : _cache = snapshotCache ?? TtlCache(const Duration(milliseconds: {{ttlMs}})),
        _streams = streamRegistry ?? SharedStreamRegistry.instance;

  static const _streamDomainKey = '{{domainStreamKey}}';

  final TtlCache<{{Pascal}}Info> _cache;
  final SharedStreamRegistry _streams;

  @override
  Future<{{Pascal}}Info> snapshot({bool forceRefresh = false}) {
    return _cache.read(
      () async => map{{Pascal}}InfoDto({{snapshotFnDart}}()),
      forceRefresh: forceRefresh,
    );
  }

  @override
  Stream<{{Pascal}}StreamSample> {{streamMethod}}({
    Duration interval = const Duration(seconds: 1),
  }) {
    return _streams.get<{{Pascal}}StreamSample>(
      domainKey: _streamDomainKey,
      requested: interval,
      minInterval: _streamMinInterval(),
      createRawStream: (clamped) => {{streamFnDart}}(
        intervalMs: BigInt.from(clamped.inMilliseconds),
      ).map(map{{Pascal}}StreamSampleDto),
    );
  }
}

Duration _streamMinInterval() {
  if (Platform.isAndroid || Platform.isIOS) {
    return const Duration(milliseconds: 200);
  }
  return const Duration(milliseconds: 50);
}
